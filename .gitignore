# Local team login credentials written by scripts/setup-team.mjs (never commit)
.team-credentials.json
scripts/.cache/

# Working files for the Mr. Mustard call ad (takes, renders, screen captures).
# The rig lives in scripts/mustard-ad; only the finished cut is committed.
.mustard-ad/

# Rendered drip letters from scripts/celebrate-letters.mts (proofing only)
.letters/

# One lockfile. This repo resolves dependencies with pnpm everywhere: CI, Vercel,
# and local. A stray install by another package manager writes a second lockfile
# that Vercel would then build from, shipping dependency versions CI never tested.
package-lock.json
yarn.lock

# vapi-bench.mjs caller audio and saved bot audio
.vapi-bench/
