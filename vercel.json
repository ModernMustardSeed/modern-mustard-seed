{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "5 6 * * 1"
    },
    {
      "path": "/api/cron/intake-nudge",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/suite-sweep",
      "schedule": "45 15 * * *"
    },
    {
      "path": "/api/cron/chief-briefing",
      "schedule": "5 13 * * *"
    },
    {
      "path": "/api/cron/mustard-sequence",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/cron/commissions",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/cron/outreach-cadence",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "5 14 * * 2-5"
    },
    {
      "path": "/api/cron/lead-digest",
      "schedule": "5 15 * * 1-5"
    },
    {
      "path": "/api/cron/operator",
      "schedule": "25 13 * * 1-5"
    },
    {
      "path": "/api/cron/outbound-audits",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron/outbound-cadence",
      "schedule": "5 18 * * 1-5"
    },
    {
      "path": "/api/cron/pilot-usage",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron/geo-watch",
      "schedule": "25 14 * * *"
    },
    {
      "path": "/api/cron/deliver",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/hundredfold-drip",
      "schedule": "50 15 * * 1-5"
    },
    {
      "path": "/api/cron/celebrate-drip",
      "schedule": "25 16 * * *"
    },
    {
      "path": "/api/cron/acquisition",
      "schedule": "0,20,40 * * * *"
    },
    {
      "path": "/api/cron/zoho-sync",
      "schedule": "2,17,32,47 * * * *"
    },
    {
      "path": "/api/cron/front-office",
      "schedule": "15 * * * *"
    }
  ]
}
